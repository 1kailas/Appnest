[Desktop Entry]
Type=Application
Name=AppNest
GenericName=AppImage Manager
Comment=Manage, integrate, and launch AppImages
Exec=appnest %U
Icon=io.github._1kailas.AppNest
Terminal=false
Categories=Utility;PackageManager;
Keywords=AppImage;Package;Manager;Installer;SquashFS;AppNest;
StartupNotify=true
StartupWMClass=appnest
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/x-appimage;
